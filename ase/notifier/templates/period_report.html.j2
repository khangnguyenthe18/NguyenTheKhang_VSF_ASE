<!DOCTYPE html>
<html lang="vi">
<head><meta charset="utf-8"><title>{{ subject }}</title></head>
{% set th = "padding: 7px 10px; text-align: left; font-size: 12px; color: #475569; font-weight: 600; background: #f8fafc; border-bottom: 1px solid #e2e8f0;" %}
{% set td = "padding: 7px 10px; font-size: 13px; color: #0f172a; border-bottom: 1px solid #f1f5f9; vertical-align: top;" %}
{% set sub = "color: #64748b; font-size: 12px;" %}
{% set colors = {"Tốt": "#16a34a", "Cần theo dõi": "#d97706", "Kém": "#dc2626", "Cao": "#dc2626", "Trung bình": "#d97706", "Thấp": "#64748b"} %}
<body style="margin: 0; padding: 16px; background: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; color: #1f2937; line-height: 1.5;">
  <table role="presentation" cellpadding="0" cellspacing="0" style="max-width: 900px; width: 100%; margin: 0 auto; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; border-collapse: separate; overflow: hidden;">
    <tr><td style="background: #1e3a8a; color: #ffffff; padding: 14px 20px;">
      <div style="font-size: 16px; font-weight: 700;">Báo cáo phiên đổi pin lỗi · {{ period_label }}</div>
      <div style="font-size: 13px; opacity: 0.9;">{{ data_note }}</div>
    </td></tr>
    <tr><td style="padding: 16px 20px 0;">
      <p style="margin: 0;">Dear Team <strong>{{ team }}</strong>,</p>
      <p style="margin: 6px 0 0;">Em xin gửi báo cáo về các phiên đổi pin lỗi trên hệ thống BSS trong {{ period_label }} như sau:</p>
    </td></tr>
    {% for s in sections %}
    <tr><td style="padding: 16px 20px 0;">
      <div style="font-size: 15px; font-weight: 700; margin-bottom: 4px;">Hệ thống BSS {{ s.country_label }}</div>
      <p style="margin: 0 0 6px;">Top {{ s.top | length }} lỗi đang chiếm số lượng lớn <strong>{{ s.top_pct }}%</strong> trong tổng số <strong>{{ s.n_failures }}</strong> các phiên lỗi:</p>
      <ol style="margin: 0 0 8px; padding-left: 22px;">
        {% for c in s.top %}<li><strong>{{ c.code }}</strong> – {{ c.name }}{% if c.level %} <span style="{{ sub }}">({{ c.level }})</span>{% endif %}, chiếm <strong>{{ c.pct }}%</strong> ({{ c.n }} case)</li>{% endfor %}
      </ol>
      <table cellpadding="0" cellspacing="0" style="border-collapse: collapse; width: 100%; border: 1px solid #e2e8f0; margin-top: 6px;">
        <tr><th style="{{ th }}" colspan="2">KPI success factor của luồng đổi pin</th></tr>
        <tr><td style="{{ td }}">Tổng giao dịch</td><td style="{{ td }}">{{ s.n_total }}</td></tr>
        <tr><td style="{{ td }}">Tỷ lệ đổi pin thành công</td><td style="{{ td }}"><strong>{{ s.success_rate }}</strong></td></tr>
        <tr><td style="{{ td }}">Phiên lỗi (Thất bại / kẹt)</td><td style="{{ td }}">{{ s.n_failures }} ({{ s.n_failed }} / {{ s.n_stuck }}) · tỷ lệ lỗi {{ s.failure_rate }}{% if s.prev_failure_rate %} <span style="{{ sub }}">(kỳ trước {{ s.prev_failure_rate }})</span>{% endif %}</td></tr>
        <tr><td style="{{ td }}">Thời gian một lần đổi</td><td style="{{ td }}">p50 {{ s.swap_p50 }} · p95 {{ s.swap_p95 }}</td></tr>
        <tr><td style="{{ td }}">Khách đã trả pin, chưa nhận pin mới</td><td style="{{ td }}">{{ s.n_returned_not_received }}</td></tr>
        <tr><td style="{{ td }}">Khách bị ảnh hưởng</td><td style="{{ td }}">{{ s.n_users_affected }} <span style="{{ sub }}">(thất bại ≥ {{ repeat_min }} lần/ngày: {{ s.n_repeat_users }})</span></td></tr>
      </table>
      <table cellpadding="0" cellspacing="0" style="border-collapse: collapse; width: 100%; border: 1px solid #e2e8f0; margin-top: 10px;">
        <tr><th style="{{ th }}">Dịch vụ critical</th><th style="{{ th }}">Health score</th><th style="{{ th }}">Giao dịch lỗi</th></tr>
        {% for h in s.services %}<tr><td style="{{ td }}">{{ h.service_name }}</td><td style="{{ td }} color: {{ colors[h.label] }}; font-weight: 700;">{{ h.score }} · {{ h.label }}</td><td style="{{ td }}">{{ h.n_fail }} ({{ h.fail_pct }}%)</td></tr>{% endfor %}
        {% for h in s.weak_cabinets %}<tr><td style="{{ td }}">Tủ {{ h.entity }}</td><td style="{{ td }} color: {{ colors[h.label] }}; font-weight: 700;">{{ h.score }} · {{ h.label }}</td><td style="{{ td }}">{{ h.n_fail }}/{{ h.n_total }} ({{ h.fail_pct }}%)</td></tr>{% endfor %}
      </table>
      {% if s.open_points %}
      <div style="font-size: 14px; font-weight: 700; margin: 12px 0 4px;">Open point và đề xuất</div>
      <table cellpadding="0" cellspacing="0" style="border-collapse: collapse; width: 100%; border: 1px solid #e2e8f0;">
        <tr><th style="{{ th }}">Ưu tiên</th><th style="{{ th }}">Open point</th><th style="{{ th }}">Đề xuất</th></tr>
        {% for o in s.open_points %}<tr><td style="{{ td }} color: {{ colors[o.priority] }}; font-weight: 700; white-space: nowrap;">{{ o.priority }}</td><td style="{{ td }}">{{ o.title }}<div style="{{ sub }}">{{ o.impact }} · bằng chứng: {{ o.evidence | join(", ") }}</div></td><td style="{{ td }}">{{ o.recommendations | join("<br>" | safe) }}</td></tr>{% endfor %}
      </table>
      {% if s.n_open_points > s.open_points | length %}<p style="{{ sub }}">Còn {{ s.n_open_points - (s.open_points | length) }} open point trong tệp đính kèm.</p>{% endif %}
      {% endif %}
    </td></tr>
    {% endfor %}
    <tr><td style="padding: 16px 20px;"><p style="{{ sub }} margin: 0;">Tệp đính kèm <code>{{ csv_filename }}</code> · Mã báo cáo <code>{{ report_id }}</code> · Số liệu do hệ thống tính từ Danh sách giao dịch đổi pin; AI chỉ gợi ý, quyết định cuối cùng thuộc về OPS.</p></td></tr>
  </table>
</body>
</html>
