<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <title>{{ subject }}</title>
</head>
{% set label_td = "padding: 7px 12px; color: #64748b; font-size: 13px; white-space: nowrap; vertical-align: top; width: 130px; border-top: 1px solid #f1f5f9;" %}
{% set value_td = "padding: 7px 12px; color: #0f172a; font-size: 14px; vertical-align: top; border-top: 1px solid #f1f5f9;" %}
<body style="margin: 0; padding: 16px; background: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; color: #1f2937; line-height: 1.5;">
  <table role="presentation" cellpadding="0" cellspacing="0" style="max-width: 680px; width: 100%; margin: 0 auto; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; border-collapse: separate; overflow: hidden;">
    <tr>
      <td style="background: {{ severity_color }}; color: #ffffff; padding: 14px 20px;">
        <span style="display: inline-block; background: rgba(255,255,255,0.22); border-radius: 4px; padding: 2px 8px; font-weight: 700; font-size: 13px;">{{ severity }}</span>
        <span style="font-size: 16px; font-weight: 700; margin-left: 6px;">Giao dịch lỗi · {{ category_label }}</span>
        {% if revision > 1 %}<span style="font-size: 13px; margin-left: 6px;">(cập nhật lần #{{ revision }})</span>{% endif %}
        <div style="font-size: 13px; opacity: 0.95; margin-top: 4px;">{{ time_display }}</div>
      </td>
    </tr>
    <tr>
      <td style="padding: 18px 20px 4px;">
        <p style="margin: 0 0 6px;">Dear Team <strong>{{ team }}</strong>,</p>
        <p style="margin: 0 0 14px;">Hệ thống kiểm tra có giao dịch lỗi có thể liên quan đến <strong>{{ category_label }}</strong>, cần kiểm tra khắc phục.</p>
        <a href="{{ session_url }}" style="display: inline-block; padding: 10px 18px; background: #1d4ed8; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 14px;">Xem giao dịch {{ session_id }} trên dashboard →</a>
      </td>
    </tr>
    <tr>
      <td style="padding: 14px 20px 0;">
        <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border: 1px solid #e2e8f0; border-radius: 6px; border-collapse: separate;">
          <tr><td style="{{ label_td }} border-top: 0;">Mã giao dịch</td><td style="{{ value_td }} border-top: 0;"><a href="{{ session_url }}" style="color: #1d4ed8; font-family: Consolas, monospace; font-weight: 600;">{{ session_id }}</a></td></tr>
          <tr><td style="{{ label_td }}">Thời gian</td><td style="{{ value_td }}">{{ time_display }}</td></tr>
          <tr><td style="{{ label_td }}">Quốc gia</td><td style="{{ value_td }}">{{ country_display }}</td></tr>
          <tr><td style="{{ label_td }}">Trạm / Tủ</td><td style="{{ value_td }}">{{ station_display }}</td></tr>
          <tr><td style="{{ label_td }}">Bước lỗi</td><td style="{{ value_td }}">{{ step_label }}<div style="color: #64748b; font-size: 12px;">{{ step }} – {{ step_description }}</div></td></tr>
          <tr><td style="{{ label_td }}">Mã lỗi</td><td style="{{ value_td }}"><code style="background: #f1f5f9; padding: 1px 6px; border-radius: 4px;">{{ error_code_display }}</code>{% if error_description %} {{ error_description }}{% endif %}</td></tr>
          <tr><td style="{{ label_td }}">Phân loại AI</td><td style="{{ value_td }}">{{ category_code }} ({{ category_label }}) – <strong style="color: {{ severity_color }};">{{ severity }}</strong> – Độ tin cậy {{ confidence_display }}{% if needs_human_review %} <span style="color: #dc2626; font-weight: 600;">(Cần OPS xem xét)</span>{% endif %}</td></tr>
          <tr><td style="{{ label_td }}">Phạm vi</td><td style="{{ value_td }}">{{ n_sessions }} giao dịch cùng lỗi tại {{ n_stations }} trạm trong {{ window_minutes }} phút <span style="color: #64748b;">({{ incident_id }})</span></td></tr>
        </table>
      </td>
    </tr>
    <tr>
      <td style="padding: 14px 20px 0;">
        <div style="background: #f8fafc; border-left: 3px solid #6366f1; border-radius: 4px; padding: 10px 14px; font-size: 14px;">
          <div style="font-size: 12px; color: #6366f1; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 4px;">AI gợi ý · cần OPS xác thực</div>
          <div><strong>Nguyên nhân khả nghi:</strong> {{ probable_cause }}</div>
          <div><strong>Bằng chứng:</strong> {{ evidence_display }}</div>
          <div><strong>Đề xuất xử lý:</strong> {{ suggested_actions_display }} (Runbook {{ runbook_display }})</div>
        </div>
      </td>
    </tr>
    <tr>
      <td style="padding: 16px 20px 6px;">
        <div style="font-size: 12px; color: #64748b; margin-bottom: 6px;">Phản hồi của OPS:</div>
        <a href="{{ confirm_url }}" style="display: inline-block; padding: 7px 14px; margin: 0 6px 6px 0; background: #16a34a; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: 600; font-size: 13px;">Xác nhận đúng</a>
        <a href="{{ wrong_category_url }}" style="display: inline-block; padding: 7px 14px; margin: 0 6px 6px 0; background: #dc2626; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: 600; font-size: 13px;">Sai phân loại</a>
        <a href="{{ resolved_url }}" style="display: inline-block; padding: 7px 14px; margin: 0 6px 6px 0; background: #475569; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: 600; font-size: 13px;">Đã xử lý</a>
      </td>
    </tr>
    <tr>
      <td style="padding: 8px 20px 16px; border-top: 1px solid #e2e8f0; font-size: 12px; color: #64748b;">
        -- AI chỉ gợi ý, quyết định cuối cùng thuộc về OPS. · <a href="{{ alerts_url }}" style="color: #64748b;">Xem giao dịch lỗi trên dashboard</a>
      </td>
    </tr>
  </table>
</body>
</html>
