{% extends "base.html.j2" %}
{% block title %}Kiểm chứng Ground Truth (Mock) — ASE BSS NOC{% endblock %}
{% block content %}
<div class="banner-mock">
  🧪 <strong>{{ data.banner_warning }}</strong> —
  Tab này là nơi duy nhất trong toàn bộ Dashboard được phép đọc <code>ground_truth.csv</code> để phục vụ kiểm chứng simulator &amp; đối chiếu kịch bản.
</div>

<section class="kpi-grid">
  <div class="kpi-card">
    <div class="kpi-label">Tổng số phiên trong Ground Truth</div>
    <div class="kpi-value">{{ data.total_sessions }}</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Số phiên lỗi thật (<code>is_failure=true</code>)</div>
    <div class="kpi-value sev-p1">{{ data.failure_sessions }}</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Số phiên bình thường (<code>is_failure=false</code>)</div>
    <div class="kpi-value">{{ data.normal_sessions }}</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Số đợt kịch bản (<code>scenario_instance_id</code>)</div>
    <div class="kpi-value">{{ data.scenario_instances | length }}</div>
  </div>
</section>

<section class="panel">
  <div class="panel-header">
    <h2>Dòng thời gian các đợt Scenario Instance (<code>scenario_instance_id</code>)</h2>
    <span class="note-text">Bấm vào thời điểm để chuyển <code>as_of</code> tới ngay sau đợt kịch bản</span>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Instance ID</th>
          <th>Scenario</th>
          <th>Category thật</th>
          <th>Severity</th>
          <th>Mã lỗi gốc</th>
          <th>Quốc gia</th>
          <th>Split</th>
          <th>Bắt đầu (UTC)</th>
          <th>Phiên cuối (UTC)</th>
          <th>Số phiên lỗi</th>
          <th>Nhảy <code>as_of</code></th>
        </tr>
      </thead>
      <tbody>
        {% for inst in data.scenario_instances %}
        <tr>
          <td><strong><code>{{ inst.scenario_instance_id }}</code></strong></td>
          <td><code>{{ inst.scenario }}</code></td>
          <td><span class="badge">{{ inst.category }}</span></td>
          <td><span class="status-pill {% if inst.severity == 'P1' %}status-red{% else %}status-yellow{% endif %}">{{ inst.severity }}</span></td>
          <td><code>{{ inst.error_code }}</code></td>
          <td>{{ inst.countries | join(", ") }}</td>
          <td><code>{{ inst.split }}</code></td>
          <td><code>{{ inst.scenario_start_utc.strftime('%Y-%m-%d %H:%M:%S') }}Z</code></td>
          <td><code>{{ inst.last_injected_at_utc.strftime('%Y-%m-%d %H:%M:%S') }}Z</code></td>
          <td><strong>{{ inst.session_count }}</strong></td>
          <td>
            <a href="/dashboard?profile={{ meta.profile }}&amp;as_of={{ inst.last_injected_at_utc.isoformat() | urlencode }}">Xem lúc này →</a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="panel">
  <div class="panel-header">
    <h2>Bảng đếm phiên lỗi theo Category × Scenario × Quốc gia × Split</h2>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Category thật</th>
          <th>Scenario</th>
          <th>Quốc gia</th>
          <th>Split</th>
          <th>Số phiên lỗi</th>
        </tr>
      </thead>
      <tbody>
        {% for c in data.counts %}
        <tr>
          <td><strong><code>{{ c.category }}</code></strong></td>
          <td><code>{{ c.scenario }}</code></td>
          <td>{{ c.country }}</td>
          <td><code>{{ c.split }}</code></td>
          <td><strong>{{ c.count }}</strong></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}

