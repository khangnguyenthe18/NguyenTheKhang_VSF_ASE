{% extends "base.html.j2" %}
{% import "widgets.html.j2" as w %}
{% block title %}Tổng quan mạng lưới — ASE BSS NOC{% endblock %}
{% block content %}
{% set q_base = "profile=" ~ (meta.profile | urlencode) ~ ("&country=" ~ (meta.country | urlencode) if meta.country else "") ~ "&as_of=" ~ (meta.as_of.isoformat() | urlencode) %}
{% set asof_sub = "Tại as_of " ~ meta.as_of.strftime('%H:%M %d/%m (UTC)') %}

<!-- KPI Strip (Compact) -->
<section class="kpi-grid">
  <div class="kpi-card">
    <div class="kpi-label">Trạm / Tủ Online</div>
    <div class="kpi-value">{{ data.kpi_total.stations_online }}/{{ data.kpi_total.stations_total }} trạm</div>
    <div class="kpi-sub">{{ data.kpi_total.cabinets_online }}/{{ data.kpi_total.cabinets_total }} tủ có heartbeat &le; 2 phút</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Pin sẵn sàng / Tổng khoang *</div>
    <div class="kpi-value">{{ data.kpi_total.ready_batteries }}/{{ data.kpi_total.total_slots }}</div>
    <div class="kpi-sub" title="{{ data.ready_battery_note }}">SOC &ge; 90% (xấp xỉ)</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Lượt đổi hôm nay</div>
    <div class="kpi-value">{{ data.kpi_total.swaps_today }}</div>
    <div class="kpi-sub">Theo ngày địa phương từng trạm</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Tỷ lệ thành công hôm nay</div>
    <div class="kpi-value">
      {% if data.kpi_total.success_rate_today is not none %}
        {{ "%.1f"|format(data.kpi_total.success_rate_today * 100) }}%
      {% else %}
        —
      {% endif %}
    </div>
    <div class="kpi-sub">{{ data.kpi_total.completed_today }}/{{ data.kpi_total.ended_today }} phiên đã kết thúc</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Thời gian đổi (Trung vị / p95)</div>
    <div class="kpi-value">
      {% if data.kpi_total.swap_duration_median_s is not none %}
        {{ "%.1f"|format(data.kpi_total.swap_duration_median_s) }}s / {{ "%.1f"|format(data.kpi_total.swap_duration_p95_s or 0) }}s
      {% else %}
        —
      {% endif %}
    </div>
    <div class="kpi-sub">Phiên COMPLETED hôm nay</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Doanh thu hôm nay (tách tiền tệ)</div>
    <div class="kpi-value kpi-value-sm">
      {% if data.kpi_total.revenue_today_by_currency %}
        {% for curr, amt in data.kpi_total.revenue_today_by_currency.items() %}
          <div>{{ "{:,.0f}".format(amt) }} <span class="status-pill status-blue">{{ curr }}</span></div>
        {% endfor %}
      {% else %}
        0
      {% endif %}
    </div>
    <div class="kpi-sub">captured=true, không quy đổi</div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Alert đang mở (P1 / P2)</div>
    <div class="kpi-value">
      <span class="sev-p1">P1: {{ data.kpi_total.open_alerts_p1 }}</span> ·
      <span class="sev-p2">P2: {{ data.kpi_total.open_alerts_p2 }}</span>
    </div>
    <div class="kpi-sub">Từ notifier outbox &amp; Teams</div>
  </div>
</section>

<!-- HÀNG 1: Bản đồ trạm (2/3) + Bảng Trạm (1/3) (DASHBOARD_UI_PLAN §2.1) -->
<section class="overview-grid-row row-1">
  {% call w.widget_card(id="widget-station-map", title="Bản đồ Tủ đổi pin VinFast", subtitle="43.298 vị trí tủ đổi pin thực tế trên toàn quốc") %}
    <div id="stations-map" class="map-box" data-vietmap-key="{{ vietmap_key or '' }}"></div>
  {% endcall %}

  {% call w.widget_card(id="widget-station-table", title="Bảng Trạm", subtitle="Danh sách thiết bị & chỉ số vận hành") %}
    <div id="station-table-widget" class="entity-table-container"></div>
  {% endcall %}
</section>

<!-- HÀNG 2: Nhiệt độ tủ (1h) & Pin sẵn sàng (6h) (2/3) + Cảnh báo Alarms (1/3) (DASHBOARD_UI_PLAN §2.1) -->
<section class="overview-grid-row row-2">
  <div class="subgrid-2col">
    {% call w.widget_card(id="widget-cabinet-temp", title="Nhiệt độ tủ", subtitle=asof_sub ~ " – 1 giờ trước") %}
      <div class="station-select-bar">
        <label for="temp-station-select"><strong>Trạm:</strong></label>
        <select id="temp-station-select"></select>
      </div>
      <div id="chart-cabinet-temperature" class="chart-box"></div>
      <div id="cabinet-temp-legend-table"></div>
    {% endcall %}

    {% call w.widget_card(id="widget-ready-batteries", title="Pin sẵn sàng theo thời gian", subtitle=asof_sub ~ " – 6 giờ trước") %}
      <div id="chart-ready-batteries" class="chart-box"></div>
    {% endcall %}
  </div>

  {% call w.widget_card(id="widget-alarms-table", title="Cảnh báo (Alarms)", subtitle="Hợp nhất thiết bị & sự cố vận hành") %}
    <div id="alarms-table-widget" class="entity-table-container"></div>
  {% endcall %}
</section>

<!-- Phần bổ sung: Biểu đồ lượt đổi 24h & Top 5 điểm nóng -->
<section class="grid-2col" style="margin-top: 12px;">
  {% call w.widget_card(id="widget-hourly-swaps", title="Lượt đổi pin 24 giờ qua", subtitle="Theo giờ địa phương trạm") %}
    <div id="chart-hourly-swaps" class="chart-box"></div>
  {% endcall %}

  {% call w.widget_card(id="widget-hotspots", title="Top 5 điểm nóng lỗi (24 giờ qua)", subtitle="Tập trung lỗi theo trạm, tủ, khoang") %}
    <div class="table-wrap">
      <table class="data-table data-table-compact">
        <thead>
          <tr>
            <th>Loại</th>
            <th>Mã đối tượng</th>
            <th>Trạm</th>
            <th>Phiên lỗi / Tổng</th>
            <th>Tỷ lệ lỗi</th>
          </tr>
        </thead>
        <tbody>
          {% for st in data.hotspots_24h.top_stations %}
          <tr>
            <td><span class="status-pill status-blue">Trạm</span></td>
            <td><code>{{ st.entity_id }}</code></td>
            <td>{{ st.station_id }}</td>
            <td>{{ st.failed_sessions }}/{{ st.total_sessions }}</td>
            <td><strong class="sev-p1">{{ "%.1f"|format(st.fail_rate * 100) }}%</strong></td>
          </tr>
          {% endfor %}
          {% for cab in data.hotspots_24h.top_cabinets %}
          <tr>
            <td><span class="status-pill status-yellow">Tủ</span></td>
            <td><code>{{ cab.entity_id }}</code></td>
            <td>{{ cab.station_id }}</td>
            <td>{{ cab.failed_sessions }}/{{ cab.total_sessions }}</td>
            <td><strong class="sev-p2">{{ "%.1f"|format(cab.fail_rate * 100) }}%</strong></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endcall %}
</section>
{% endblock %}
