{% extends "base.html.j2" %}
{% block title %}Cảnh báo & Phản hồi OPS — ASE BSS NOC{% endblock %}
{% block content %}
<section class="kpi-grid">
  <div class="kpi-card">
    <div class="kpi-label">Tổng Card trên Mock Teams</div>
    <div class="kpi-value">{{ data.stats.total_cards }}</div>
    <div class="kpi-sub">Đọc từ <code>notifier.sqlite</code></div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Alert theo Team</div>
    <div class="kpi-value kpi-value-sm">
      {% for team, cnt in data.stats.by_team.items() %}
        <div>{{ team }}: <strong>{{ cnt }}</strong></div>
      {% else %}
        0
      {% endfor %}
    </div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Alert theo Category</div>
    <div class="kpi-value kpi-value-sm">
      {% for cat, cnt in data.stats.by_category.items() %}
        <div><code>{{ cat }}</code>: <strong>{{ cnt }}</strong></div>
      {% else %}
        0
      {% endfor %}
    </div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Alert theo Severity</div>
    <div class="kpi-value kpi-value-sm">
      {% for sev, cnt in data.stats.by_severity.items() %}
        <div><strong>{{ sev }}</strong>: {{ cnt }}</div>
      {% else %}
        0
      {% endfor %}
    </div>
  </div>
  <div class="kpi-card">
    <div class="kpi-label">Tỷ lệ Feedback "Sai phân loại"</div>
    <div class="kpi-value">{{ "%.1f"|format(data.stats.wrong_category_rate * 100) }}%</div>
    <div class="kpi-sub">{{ data.stats.wrong_category_count }}/{{ data.stats.feedback_total }} incident có phản hồi</div>
  </div>
</section>

<section class="panel">
  <div class="panel-header">
    <h2>Danh sách Card Cảnh báo trên Mock Teams ({{ data.cards | length }})</h2>
    <a href="/" class="btn-primary">Mở giao diện Mock Microsoft Teams →</a>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Incident ID</th>
          <th>Rev</th>
          <th>Kênh / Team</th>
          <th>Category</th>
          <th>Severity</th>
          <th>Thời điểm nhận</th>
          <th>Phản hồi mới nhất của OPS</th>
          <th>Liên kết</th>
        </tr>
      </thead>
      <tbody>
        {% for c in data.cards %}
        <tr>
          <td><strong><code>{{ c.incident_id }}</code></strong></td>
          <td><code>r{{ c.revision }}</code></td>
          <td><span class="badge">#{{ c.channel_name }} ({{ c.channel }})</span></td>
          <td><code>{{ c.category or "—" }}</code></td>
          <td>
            <span class="status-pill {% if c.severity == 'P1' %}status-red{% else %}status-yellow{% endif %}">
              {{ c.severity or "P2" }}
            </span>
          </td>
          <td><code>{{ c.received_at }}</code></td>
          <td>
            {% if c.latest_feedback_action %}
              <span class="badge">{{ c.latest_feedback_label }} ({{ c.latest_feedback_action }}) lúc {{ c.latest_feedback_at }}</span>
            {% else %}
              <span class="note-text">Chưa phản hồi</span>
            {% endif %}
          </td>
          <td>
            <a href="{{ c.teams_link }}">Card Teams</a>
            {% if c.session_link %}
              · <a href="{{ c.session_link }}">Phiên <code>{{ c.first_session_id }}</code></a>
            {% endif %}
          </td>
        </tr>
        {% else %}
        <tr><td colspan="8">Chưa có card nào trong <code>notifier.sqlite</code> (hãy chạy <code>make notify-demo</code>).</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="panel">
  <div class="panel-header">
    <h2>Bảng Transactional Outbox ({{ data.outbox | length }} dòng)</h2>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Incident</th>
          <th>Revision</th>
          <th>Kênh</th>
          <th>Chế độ</th>
          <th>Trạng thái</th>
          <th>Số lần thử</th>
          <th>Lỗi cuối</th>
          <th>Tạo lúc</th>
          <th>Gửi lúc</th>
          <th>Phiên đầu</th>
        </tr>
      </thead>
      <tbody>
        {% for o in data.outbox %}
        <tr>
          <td><code>{{ o.incident_id }}</code></td>
          <td><code>r{{ o.revision }}</code></td>
          <td><code>{{ o.channel }}</code></td>
          <td><span class="badge">{{ o.mode }}</span></td>
          <td>
            <span class="status-pill {% if o.status == 'SENT' %}status-green{% elif o.status == 'FAILED' %}status-red{% else %}status-yellow{% endif %}">
              {{ o.status }}
            </span>
          </td>
          <td>{{ o.attempts }}</td>
          <td><code>{{ o.last_error or "—" }}</code></td>
          <td><code>{{ o.created_at }}</code></td>
          <td><code>{{ o.sent_at or "—" }}</code></td>
          <td>
            {% if o.first_session_id %}
              <a href="/dashboard/sessions/{{ o.first_session_id }}?profile={{ meta.profile }}"><code>{{ o.first_session_id }}</code></a>
            {% else %}—{% endif %}
          </td>
        </tr>
        {% else %}
        <tr><td colspan="10">Bảng outbox đang trống.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}

