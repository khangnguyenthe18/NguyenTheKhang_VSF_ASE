{% extends "base.html.j2" %}
{% block title %}Chất lượng Pin & Nhiệt độ Tủ — ASE BSS NOC{% endblock %}
{% block content %}
{% set q_base = "profile=" ~ (meta.profile | urlencode) ~ ("&country=" ~ (meta.country | urlencode) if meta.country else "") ~ "&as_of=" ~ (meta.as_of.isoformat() | urlencode) %}

<div class="grid-2col">
  <section class="panel">
    <div class="panel-header">
      <h2>Phân bố SOH theo Lô pin (<code>lot_id</code> — Box Plot)</h2>
      <span class="note-text">Ngưỡng SOH thấp: &lt; {{ data.low_soh_threshold_pct }}%</span>
    </div>
    <div id="chart-lot-soh" class="chart-box"></div>
    <div class="table-wrap mt-12">
      <table class="data-table data-table-compact">
        <thead>
          <tr>
            <th>Lô pin</th>
            <th>Số pin</th>
            <th>Min</th>
            <th>Q1</th>
            <th>Median</th>
            <th>Q3</th>
            <th>Max</th>
            <th>Trung bình</th>
            <th>Đánh giá</th>
          </tr>
        </thead>
        <tbody>
          {% for b in data.soh_by_lot %}
          <tr>
            <td><strong><code>{{ b.lot_id }}</code></strong></td>
            <td>{{ b.battery_count }}</td>
            <td>{{ b.min_soh }}%</td>
            <td>{{ b.q1_soh }}%</td>
            <td>{{ b.median_soh }}%</td>
            <td>{{ b.q3_soh }}%</td>
            <td>{{ b.max_soh }}%</td>
            <td><strong>{{ b.mean_soh }}%</strong></td>
            <td>
              {% if b.is_low_soh_lot %}
                <span class="status-pill status-red">LÔ SOH THẤP (&lt; {{ data.low_soh_threshold_pct }}%)</span>
              {% else %}
                <span class="status-pill status-green">Bình thường</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel">
    <div class="panel-header">
      <h2>Phân bố SOC lúc xuất pin</h2>
      <span class="note-text">Ngưỡng SOC thấp: &lt; {{ data.low_soc_threshold_pct }}% ({{ data.low_soc_out_count }}/{{ data.total_soc_out_readings }} lần đọc)</span>
    </div>
    <div id="chart-soc-out" class="chart-box"></div>

    <div class="panel-header mt-16">
      <h2>Nhiệt độ cao nhất theo Tủ (Cảnh báo mức 1: &gt; {{ data.temp_warn_1_c }}°C · Mức 2: &gt; {{ data.temp_warn_2_c }}°C)</h2>
    </div>
    <div id="chart-cabinet-temp" class="chart-box"></div>
  </section>
</div>

<section class="panel">
  <div class="panel-header">
    <h2>Bảng giám sát nhiệt độ Tủ &amp; Mã cảnh báo phần cứng</h2>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Tủ</th>
          <th>Trạm (Nước)</th>
          <th>Nhiệt độ cao nhất</th>
          <th>Nhiệt độ gần nhất</th>
          <th>Số lần &gt; {{ data.temp_warn_1_c }}°C (Mức 1)</th>
          <th>Số lần &gt; {{ data.temp_warn_2_c }}°C (Mức 2 / Ngắt nguồn)</th>
          <th>Mã lỗi phần cứng</th>
          <th>Trạng thái nhiệt</th>
        </tr>
      </thead>
      <tbody>
        {% for c in data.cabinet_temperatures %}
        <tr>
          <td><code>{{ c.cabinet_id }}</code></td>
          <td><a href="/dashboard/stations/{{ c.station_id }}?{{ q_base }}">{{ c.station_id }}</a> ({{ c.country }})</td>
          <td><strong>{{ c.max_temp_c }}°C</strong></td>
          <td>{{ (c.latest_temp_c ~ "°C") if c.latest_temp_c is not none else "—" }}</td>
          <td>{{ c.warn_1_events }}</td>
          <td>{{ c.warn_2_events }}</td>
          <td><code>{{ c.hw_error_codes | join(", ") if c.hw_error_codes else "—" }}</code></td>
          <td>
            {% if c.exceeds_warn_2 %}
              <span class="status-pill status-red">CẢNH BÁO MỨC 2 (&gt; {{ data.temp_warn_2_c }}°C)</span>
            {% elif c.exceeds_warn_1 %}
              <span class="status-pill status-yellow">CẢNH BÁO MỨC 1 (&gt; {{ data.temp_warn_1_c }}°C)</span>
            {% else %}
              <span class="status-pill status-green">Bình thường</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="panel">
  <div class="panel-header">
    <h2>Danh sách pin SOH thấp (&lt; {{ data.low_soh_threshold_pct }}%) đã xuất cho khách ({{ data.low_soh_issued | length }} lượt)</h2>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Mã phiên</th>
          <th>Trạm (Nước)</th>
          <th>Tủ / Khoang xuất</th>
          <th>Mã pin</th>
          <th>Lô pin</th>
          <th>SOH</th>
          <th>Trạng thái phiên</th>
          <th>Thời gian (địa phương)</th>
        </tr>
      </thead>
      <tbody>
        {% for item in data.low_soh_issued %}
        <tr>
          <td><a href="/dashboard/sessions/{{ item.session_id }}?{{ q_base }}"><strong>{{ item.session_id }}</strong></a></td>
          <td><a href="/dashboard/stations/{{ item.station_id }}?{{ q_base }}">{{ item.station_id }}</a> ({{ item.country }})</td>
          <td><code>{{ item.cabinet_id or "—" }}</code> / <code>{{ item.slot_out or "—" }}</code></td>
          <td><code>{{ item.battery_id }}</code></td>
          <td><span class="status-pill status-red">{{ item.lot_id }}</span></td>
          <td><strong>{{ item.soh }}%</strong></td>
          <td><code>{{ item.final_status }}</code></td>
          <td><code>{{ item.started_at_local }}</code></td>
        </tr>
        {% else %}
        <tr><td colspan="8">Chưa có pin SOH thấp nào được xuất.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}

