ASE_LLM_PROVIDER=anthropic
ASE_LLM_MODEL=claude-haiku-5-5
ASE_TRIAGE_MODE=single_shot
ASE_LLM_BUDGET_USD=30
ASE_LLM_RUN_BUDGET_USD=2
ASE_LLM_MAX_OUTPUT_TOKENS=800
ASE_ALLOW_EXTERNAL_LLM_ON_MASKED=true   # đặt false + ASE_LLM_PROVIDER=ollama nếu không được phép
ANTHROPIC_API_KEY=            # key riêng ase-dev, không commit

# Cấu hình SMTP: mặc định Mailpit local; dự án thật điền SMTP công ty
ASE_SMTP_HOST=
ASE_SMTP_PORT=
ASE_SMTP_TLS=
ASE_SMTP_USER=
ASE_SMTP_PASSWORD=
ASE_MAIL_FROM=
ASE_MAIL_TO=
ASE_NOTIFY_MODE=

# Dashboard: nền bản đồ Vietmap (đăng ký key tại maps.vietmap.vn/console-v2/register;
# key lộ ra trình duyệt nên giới hạn HTTP referer là localhost trong console Vietmap)
ASE_VIETMAP_API_KEY=            # hoặc VIETMAP_BROWSER_API_KEY; chỉ dùng browser key, không dùng server key
ASE_DASHBOARD_PROFILE=demo        # profile dashboard mở mặc định (không có thì dùng dev)
ASE_MOCK_TEAMS_UI=false           # true: "/" hiện trang card mock Teams; false: "/" mở thẳng dashboard

# Streaming: MQTT (Mosquitto) + Kafka (Redpanda) (STREAMING_PLAN §5)
ASE_KAFKA_BOOTSTRAP=localhost:19092
ASE_KAFKA_EVENTS_TOPIC=ase.swap.events
ASE_KAFKA_TELEMETRY_TOPIC=ase.cabinet.telemetry
ASE_KAFKA_GROUP_ID=ase-detector
ASE_MQTT_HOST=localhost
ASE_MQTT_PORT=1883
ASE_MQTT_QOS=1
